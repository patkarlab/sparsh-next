#!/bin/bash
#PBS -N sparsh_next_relabel
#PBS -q short
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=03:00:00
#PBS -j oe
# Fifth round (docs/EXPERIMENTS.md): a relabelled training pickle, an exclusion list and a groups file.
# CPU only. Submit from the sparsh-next folder:
#   qsub -v RELABEL_DIR=$HOME/sparsh_next_runs/data_checks/relabel_25Sep jobs/prepare_relabel.pbs
# RELABEL_DIR holds the lists; every relabel_*.csv in it is applied (Sample_ID,new_label,reason):
#   relabel_npm1_idh.csv, relabel_nup98_nsd1.csv, relabel_etv6_mnx1.csv;
#   drop_25Sep2026.txt (samples left out) and patients_25Sep2026.csv (samples of one patient).
# RENAMES="OLD=NEW ..." renames whole classes (default: T-ALL_TAL1=T-ALL_TAL1-like). Outputs:
#   NEW_DATA_PATH                                  the relabelled pickle (the input pickle is not changed)
#   $RUNS_DIR/data_checks/exclude_25Sep2026.txt    EXCLUDE_IDS plus the drop list
#   $RUNS_DIR/data_checks/groups_25Sep2026.csv     GROUPS_FILE merged with the patient list

set -eo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[ -f jobs/common.sh ] || { echo "ERROR: submit from the sparsh-next folder (cd ~/projects/sparsh-next)"; exit 1; }
source "${SETTINGS_FILE:-jobs/settings.sh}"
CUDA_MODULE=""
source jobs/common.sh
RELABEL_DIR="${RELABEL_DIR:?Set RELABEL_DIR}"
NEW_DATA_PATH="${NEW_DATA_PATH:-$(dirname "$DATA_PATH")/AL_25Sep2026_relabel.pkl}"
RENAMES="${RENAMES-T-ALL_TAL1=T-ALL_TAL1-like}"
for f in drop_25Sep2026.txt patients_25Sep2026.csv; do
    require_file "$f" "$RELABEL_DIR/$f" "Copy the lists into $RELABEL_DIR"
done
require_file DATA_PATH "$DATA_PATH"
shopt -s nullglob
RELABELS=("$RELABEL_DIR"/relabel_*.csv)
shopt -u nullglob
[ ${#RELABELS[@]} -gt 0 ] || { echo "ERROR: no relabel_*.csv in $RELABEL_DIR"; exit 1; }
echo "Relabel lists: ${RELABELS[*]}"
CHECKS="$RUNS_DIR/data_checks"
mkdir -p "$CHECKS"

echo "== Relabelled pickle"
# shellcheck disable=SC2086  # RENAMES is a word list
python scripts/make_training_pickle.py --data_path "$DATA_PATH" --output "$NEW_DATA_PATH" \
    --relabel "${RELABELS[@]}" ${RENAMES:+--rename $RENAMES}

echo "== Exclusion list and groups"
cat ${EXCLUDE_IDS:+"$EXCLUDE_IDS"} "$RELABEL_DIR/drop_25Sep2026.txt" | sed '/^\s*$/d' | sort -u > "$CHECKS/exclude_25Sep2026.txt"
echo "$(wc -l < "$CHECKS/exclude_25Sep2026.txt") Sample_IDs in $CHECKS/exclude_25Sep2026.txt"
python scripts/merge_groups.py ${GROUPS_FILE:+--groups "$GROUPS_FILE"} --patients "$RELABEL_DIR/patients_25Sep2026.csv" \
    --output "$CHECKS/groups_25Sep2026.csv"
echo "Finished $(date)"
