#!/bin/bash
#PBS -N sparsh_next_checks
#PBS -q a40
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=02:00:00
#PBS -j oe
# Same queue and resources as train_focal_fast.pbs, so it runs where your jobs already run.
# The checks themselves use only the CPU.
# Submit from the sparsh-next folder:  qsub jobs/check_data.pbs

set -eo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[ -f jobs/common.sh ] || { echo "ERROR: submit from the sparsh-next folder (cd ~/projects/sparsh-next)"; exit 1; }
source "${SETTINGS_FILE:-jobs/settings.sh}"
source jobs/common.sh
require_file DATA_PATH "$DATA_PATH"
[ -z "$EXCLUDE_IDS" ] || require_file EXCLUDE_IDS "$EXCLUDE_IDS"

# shellcheck disable=SC2086  # EXCLUDE_PREFIXES is a word list
python scripts/check_data.py \
  --data_path "$DATA_PATH" \
  --output_dir "$RUNS_DIR/data_checks" \
  ${EXCLUDE_IDS:+--exclude_ids "$EXCLUDE_IDS"} \
  --exclude_prefixes $EXCLUDE_PREFIXES
