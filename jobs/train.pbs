#!/bin/bash
# =============================================================================
# SPARSH training job — PBS template
#
# This is a TEMPLATE. Set the variables below (or export them before
# submission) and adjust the scheduler directives for your cluster. No absolute
# paths, usernames, dataset names, or environment names are hard-coded.
#
# Submit from the repository root, e.g.:
#   DATA_PATH=/path/to/methylation.pkl OUTPUT_DIR=./outputs/exp1 \
#     qsub jobs/train.pbs
# =============================================================================

#PBS -N sparsh_train
#PBS -q gpu                          # <-- set to your GPU queue (e.g. h100, a40)
#PBS -l select=1:ncpus=8:ngpus=1:mem=120gb
#PBS -l walltime=48:00:00
#PBS -j oe

set -eo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"

echo "Running on $(hostname)"
echo "Started at $(date)"

# --- User-configurable paths (override via environment variables) ------------
DATA_PATH="${DATA_PATH:?Set DATA_PATH to your methylation pickle}"
JUNK_PATH="${JUNK_PATH:-}"                       # optional: file of sample IDs to exclude
OUTPUT_DIR="${OUTPUT_DIR:-./outputs/run_$(date +%Y%m%d_%H%M%S)}"
CONDA_ENV="${CONDA_ENV:-sparsh}"

# --- Environment -------------------------------------------------------------
module load cuda/12.3 2>/dev/null || true
# Activate your conda/virtualenv however your site does it, e.g.:
#   source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"

export PYTHONUNBUFFERED=1
# Required for deterministic cuBLAS (pairs with set_deterministic_mode()):
export CUBLAS_WORKSPACE_CONFIG=:4096:8

mkdir -p "$OUTPUT_DIR"

# --- Training ----------------------------------------------------------------
# The hyperparameters below are an EXAMPLE starting point, not universal values.
# Use --tune to search learning rate, dropout, weight decay, focal gamma, etc.
# with Optuna. --exclude_classes is dataset-specific.
python scripts/train.py \
  --data_path "$DATA_PATH" \
  ${JUNK_PATH:+--junk_path "$JUNK_PATH"} \
  --output_dir "$OUTPUT_DIR" \
  --exclude_classes MPAL AML_NOS B-ALL_NOS \
  --epochs 300 \
  --samples_per_class_per_batch 5 \
  --hidden_dims 1024 512 256 \
  --dropout 0.45 \
  --focal_gamma 2.0 \
  --label_smoothing 0.05 \
  --learning_rate 1e-4 \
  --weight_decay 1e-4 \
  --mask_start 0.97 \
  --mask_end 0.80 \
  --early_stopping_patience 30 \
  --lr_scheduler_patience 10 \
  --upsample_minority

echo "Finished at $(date)"
