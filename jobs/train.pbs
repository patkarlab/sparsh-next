#!/bin/bash
#PBS -N sparsh_next
#PBS -q a40
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
# Resources as in the lab's working job (train_focal_fast.pbs). The a40 queue runs at most 2 GPU
# jobs per user at a time; jobs/submit_experiments.sh spreads runs over the queues in TRAIN_QUEUES
# (jobs/settings.sh), and a single run can go elsewhere with qsub -q, e.g. qsub -q h200 -v RECIPE=... .
#
# Submit from the sparsh-next folder:
#   cd ~/projects/sparsh-next
#   qsub -v RECIPE=default jobs/train.pbs
# RECIPE is one of: default, legacy, scaled, mask_sim, schedule (the five comparison runs),
# scaled_schedule, or final (default recipe plus one extra model on all samples); or, matched to the lab's
# nanopore files (0/1 values, coverage up to 87%): wide, scaled_wide, scaled_wide_log; third round:
# scaled_wide_err, scaled_wide_aml_other, scaled_wide_aml_other_err; fourth round: scaled_wide_dil_base,
# scaled_wide_dil. See docs/EXPERIMENTS.md.
# Optional: RUN_NAME=... (folder name; defaults to the recipe name), SEED=... (default 42), and
# EXTRA_ARGS="..." for any other scripts/train.py option, for example
#   qsub -v RECIPE=default,RUN_NAME=default_seed43,SEED=43 jobs/train.pbs
#   qsub -v RECIPE=default,RUN_NAME=default_ls0,EXTRA_ARGS="--label_smoothing 0" jobs/train.pbs

set -eo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[ -f jobs/common.sh ] || { echo "ERROR: submit from the sparsh-next folder (cd ~/projects/sparsh-next)"; exit 1; }
source "${SETTINGS_FILE:-jobs/settings.sh}"
source jobs/common.sh
require_file DATA_PATH "$DATA_PATH"
[ -z "$EXCLUDE_IDS" ] || require_file EXCLUDE_IDS "$EXCLUDE_IDS"
[ -z "$GROUPS_FILE" ] || require_file GROUPS_FILE "$GROUPS_FILE"

# Second round, matched to the lab's nanopore files: one 0/1 call per covered CpG, coverage drawn from
# 2-95%, inner validation and outer scoring from 5 to 90% coverage, scored as 0/1 calls (binary) and as
# single-read calls (oneread).
WIDE="--train_sim binary --val_sim binary --eval_sims binary oneread --cov_min 0.02 --cov_max 0.95 \
--val_coverages 0.05 0.1 0.2 0.3 0.5 0.7 0.9 --eval_coverages 0.05 0.1 0.2 0.3 0.5 0.7 0.9"

# Third round. ERR: per-read call errors, drawn per training sample from 0-20%, inner validation at 10%.
# EVAL_ERR: outer folds scored without errors (the second-round rows) and at 10%, in every third-round recipe,
# so each error-trained run has a baseline with the same classes and rows. AML_OTHER: AML-MR and AML_MECOM-r
# trained as one class, AML_other, reported as "AML, no specific subtype".
EVAL_ERR="--eval_call_errors 0 0.1"
ERR="--call_error_max 0.2 --val_call_error 0.1 $EVAL_ERR"
AML_OTHER="--label_map configs/label_map_aml_other.json"
# Fourth round. DIL_EVAL: outer folds scored undiluted and with every leukaemia sample diluted by a normal marrow
# to 50% and 30% blasts (binary reads only, to keep scoring time down). DIL: half the leukaemia training samples
# diluted to 20-100% blasts, and the inner validation sets likewise.
DIL_EVAL="--eval_blasts 1 0.5 0.3 --eval_sims binary"
DIL="--dilution_prob 0.5 --blast_min 0.2 --val_dilution $DIL_EVAL"

RECIPE="${RECIPE:-default}"
case "$RECIPE" in
  default)  RECIPE_ARGS="" ;;
  legacy)   RECIPE_ARGS="--imbalance legacy_upsample --train_sim mask --val_sim mask --coverage_mode schedule" ;;
  scaled)   RECIPE_ARGS="--input_encoding scaled" ;;
  mask_sim) RECIPE_ARGS="--train_sim mask --val_sim reads" ;;
  schedule) RECIPE_ARGS="--coverage_mode schedule" ;;
  scaled_schedule) RECIPE_ARGS="--input_encoding scaled --coverage_mode schedule" ;;
  final)    RECIPE_ARGS="--final_model" ;;
  wide)            RECIPE_ARGS="$WIDE --coverage_dist uniform" ;;
  scaled_wide)     RECIPE_ARGS="$WIDE --coverage_dist uniform --input_encoding scaled" ;;
  scaled_wide_log) RECIPE_ARGS="$WIDE --coverage_dist loguniform --input_encoding scaled" ;;
  scaled_wide_err)           RECIPE_ARGS="$WIDE --coverage_dist uniform --input_encoding scaled $ERR" ;;
  scaled_wide_aml_other)     RECIPE_ARGS="$WIDE --coverage_dist uniform --input_encoding scaled $AML_OTHER $EVAL_ERR" ;;
  scaled_wide_aml_other_err) RECIPE_ARGS="$WIDE --coverage_dist uniform --input_encoding scaled $AML_OTHER $ERR" ;;
  scaled_wide_dil_base)      RECIPE_ARGS="$WIDE --coverage_dist uniform --input_encoding scaled $DIL_EVAL" ;;
  scaled_wide_dil)           RECIPE_ARGS="$WIDE --coverage_dist uniform --input_encoding scaled $DIL" ;;
  *) echo "Unknown RECIPE: $RECIPE"; exit 1 ;;
esac
RUN_NAME="${RUN_NAME:-$RECIPE}"
echo "Recipe $RECIPE | run folder $RUNS_DIR/$RUN_NAME | extra arguments: ${EXTRA_ARGS:-none}"

# shellcheck disable=SC2086  # EXCLUDE_PREFIXES, RECIPE_ARGS and EXTRA_ARGS are word lists
python scripts/train.py \
  --data_path "$DATA_PATH" \
  --output_dir "$RUNS_DIR/$RUN_NAME" \
  ${EXCLUDE_IDS:+--exclude_ids "$EXCLUDE_IDS"} \
  ${GROUPS_FILE:+--groups_file "$GROUPS_FILE"} \
  --exclude_prefixes $EXCLUDE_PREFIXES \
  --seed "${SEED:-42}" \
  $RECIPE_ARGS ${EXTRA_ARGS:-}

echo "Finished $(date)"
