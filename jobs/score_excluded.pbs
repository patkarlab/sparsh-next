#!/bin/bash
#PBS -N sparsh_next_excluded
#PBS -q short
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=02:00:00
#PBS -j oe
# How a run calls the training arrays of classes it was not trained on (scripts/score_excluded.py).
# CPU only. Reads the run's training pickle and networks;
# no nanopore files. Submit from the sparsh-next folder, for example:
#   qsub -v RUN_NAME=scaled_wide_no_mr_mecom jobs/score_excluded.pbs
# Results go to $RUNS_DIR/$RUN_NAME/excluded_check. EXTRA_ARGS="..." passes further options, e.g.
#   EXTRA_ARGS="--call_error 0.1" or EXTRA_ARGS="--prefixes AML_NOS B-ALL_NOS --output_dir <folder>"

set -eo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[ -f jobs/common.sh ] || { echo "ERROR: submit from the sparsh-next folder (cd ~/projects/sparsh-next)"; exit 1; }
source "${SETTINGS_FILE:-jobs/settings.sh}"
source jobs/common.sh
require_file "run" "$RUNS_DIR/${RUN_NAME:?Set RUN_NAME}/config.json" "No finished training run named $RUN_NAME in $RUNS_DIR"

# shellcheck disable=SC2086  # EXTRA_ARGS is a word list
python scripts/score_excluded.py --run "$RUNS_DIR/$RUN_NAME" ${EXTRA_ARGS:-}
